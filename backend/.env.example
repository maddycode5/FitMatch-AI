# Primary credentials
GNANI_ACCESS_KEY=your_primary_access_key
GNANI_TOKEN=

# Secondary credentials
GNANI_FALLBACK_ACCESS_KEY=
GNANI_FALLBACK_TOKEN=

# Backup credentials
