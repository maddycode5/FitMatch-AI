# ========================================================
# FitMatch AI - Voice API Configuration (Gnani.ai)
# ========================================================

# Primary Gnani API Key
VITE_GNANI_ACCESS_KEY=your_primary_gnani_key_here
VITE_GNANI_TOKEN=

# Secondary Fallback Key (Auto-switched if primary credits exhaust)
VITE_GNANI_FALLBACK_ACCESS_KEY=your_fallback_key_here
VITE_GNANI_FALLBACK_TOKEN=

# Tertiary Backup Key (Optional third key)
VITE_GNANI_BACKUP_ACCESS_KEY=
VITE_GNANI_BACKUP_TOKEN=

# Custom Voice Clone ID (From Gnani Voice Studio portal)
VITE_GNANI_VOICE_CLONE_ID=

# Language & Accent (e.g. en-IN, en-US, hi-IN)
VITE_GNANI_LANG=en-IN

# Gnani Production Endpoints
VITE_GNANI_TTS_ENDPOINT=https://tts.gnani.ai/api/v1/tts
VITE_GNANI_STT_ENDPOINT=https://stt.gnani.ai/api/v1/stt
